# Copy this file to .env and fill it in. Never commit .env - it holds your bot token.
# On Render these go in the Environment tab instead of a file.

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- how selective the signals are ---
CONFIDENCE_THRESHOLD=74      # 72 is about 8 signals/day, 78 about 3/day

# --- risk ---
ACCOUNT_BALANCE=             # your real balance; leave blank to see risk as a % only
RISK_PERCENT=1               # percent of balance risked per trade
ACCOUNT_CURRENCY=USD
MAX_OPEN_TRADES=3            # positions held at once across all symbols
DAILY_LOSS_LIMIT_R=3         # pause new entries after losing this many R in a day

# --- stop and target, in multiples of ATR ---
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0
TIME_STOP_BARS=24            # 24 candles = 6 hours before a stale trade is called

# --- stop management (both OFF: the backtest says they hurt) ---
BREAKEVEN_AT_R=0
TRAIL_AFTER_R=0
TRAIL_DISTANCE_R=1
